@model IEnumerable<ErpAccounting.Web.Models.JournalEntry>
@{
	ViewData["Title"] = "Journal Entries";
}
<h1>Journal Entries</h1>
<p>
	<a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
	<thead>
		<tr>
			<th>Date</th>
			<th>Reference</th>
			<th>Description</th>
			<th>Lines</th>
			<th>Debit</th>
			<th>Credit</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var e in Model)
		{
			<tr>
				<td>@e.Date.ToString("yyyy-MM-dd")</td>
				<td>@e.Reference</td>
				<td>@e.Description</td>
				<td>@e.Lines.Count</td>
				<td>@e.Lines.Sum(l => l.Debit).ToString("N2")</td>
				<td>@e.Lines.Sum(l => l.Credit).ToString("N2")</td>
				<td>
					<a asp-action="Edit" asp-route-id="@e.Id">Edit</a> |
					<a asp-action="Details" asp-route-id="@e.Id">Details</a> |
					<a asp-action="Delete" asp-route-id="@e.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>