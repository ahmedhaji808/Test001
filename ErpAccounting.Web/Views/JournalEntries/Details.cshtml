@model ErpAccounting.Web.Models.JournalEntry
@{
	ViewData["Title"] = "Journal Entry Details";
}
<h1>Journal Entry Details</h1>
<div class="mb-3">
	<dl class="row">
		<dt class="col-sm-2">Date</dt>
		<dd class="col-sm-10">@Model.Date.ToString("yyyy-MM-dd")</dd>
		<dt class="col-sm-2">Reference</dt>
		<dd class="col-sm-10">@Model.Reference</dd>
		<dt class="col-sm-2">Description</dt>
		<dd class="col-sm-10">@Model.Description</dd>
	</dl>
</div>
<table class="table table-sm table-striped">
	<thead>
		<tr>
			<th>Account</th>
			<th class="text-end">Debit</th>
			<th class="text-end">Credit</th>
			<th>Memo</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var l in Model.Lines)
		{
			<tr>
				<td>@l.Account?.Name (@l.AccountId)</td>
				<td class="text-end">@l.Debit.ToString("N2")</td>
				<td class="text-end">@l.Credit.ToString("N2")</td>
				<td>@l.Memo</td>
			</tr>
		}
	</tbody>
	<tfoot>
		<tr>
			<th>Total</th>
			<th class="text-end">@Model.Lines.Sum(x => x.Debit).ToString("N2")</th>
			<th class="text-end">@Model.Lines.Sum(x => x.Credit).ToString("N2")</th>
			<th></th>
		</tr>
	</tfoot>
</table>
<p>
	<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
	<a class="btn btn-secondary" asp-action="Index">Back to List</a>
</p>