@model ErpAccounting.Web.Models.Account
@{
	ViewData["Title"] = "Create Account";
}
<h1>Create Account</h1>
<hr />
<div class="row">
	<div class="col-md-6">
		<form asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="mb-3">
				<label asp-for="Code" class="form-label"></label>
				<input asp-for="Code" class="form-control" />
				<span asp-validation-for="Code" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Name" class="form-label"></label>
				<input asp-for="Name" class="form-control" />
				<span asp-validation-for="Name" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Type" class="form-label"></label>
				<select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ErpAccounting.Web.Models.AccountType>()"></select>
				<span asp-validation-for="Type" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="NormalBalance" class="form-label"></label>
				<select asp-for="NormalBalance" class="form-select" asp-items="Html.GetEnumSelectList<ErpAccounting.Web.Models.NormalBalance>()"></select>
				<span asp-validation-for="NormalBalance" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<div class="form-check">
					<input class="form-check-input" asp-for="IsActive" />
					<label class="form-check-label" asp-for="IsActive">Active</label>
				</div>
			</div>
			<div class="mb-3">
				<label asp-for="ParentAccountId" class="form-label">Parent Account</label>
				<select asp-for="ParentAccountId" class="form-select" asp-items="ViewBag.ParentAccountId">
					<option value="">-- None --</option>
				</select>
			</div>
			<button type="submit" class="btn btn-primary">Create</button>
			<a asp-action="Index" class="btn btn-secondary">Back to List</a>
		</form>
	</div>
</div>
@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}