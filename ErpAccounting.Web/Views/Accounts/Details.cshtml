@model ErpAccounting.Web.Models.Account
@{
	ViewData["Title"] = "Account Details";
}
<h1>Account Details</h1>
<div>
	<dl class="row">
		<dt class="col-sm-2">Code</dt>
		<dd class="col-sm-10">@Model.Code</dd>
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@Model.Name</dd>
		<dt class="col-sm-2">Type</dt>
		<dd class="col-sm-10">@Model.Type</dd>
		<dt class="col-sm-2">Normal</dt>
		<dd class="col-sm-10">@Model.NormalBalance</dd>
		<dt class="col-sm-2">Active</dt>
		<dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
		<dt class="col-sm-2">Parent</dt>
		<dd class="col-sm-10">@Model.ParentAccount?.Name</dd>
	</dl>
</div>
<p>
	<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
	<a class="btn btn-secondary" asp-action="Index">Back to List</a>
</p>